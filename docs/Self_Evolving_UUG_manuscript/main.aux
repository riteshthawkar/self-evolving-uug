\@writefile{brf}{\backcite{hong2025dualselfrewards}{{10}{4.2}{table.caption.12}}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Signal analysis on BLIP3o-8B revealing the complementary roles of our self-evolving training signals. (a)~The STE difficulty distribution shifts toward harder quantiles as training progresses, reflecting the emergence of an adaptive curriculum where the \emph  {Proposer} generates increasingly challenging questions matched to the \emph  {Solver}'s evolving competence. (b)~Self-consistency entropy and STE occupy complementary regions of the difficulty space: self-consistency captures framing-level robustness while STE detects token-level uncertainty, together providing a richer supervision signal than either alone. (c)~Both QA fidelity and cycle-consistency image generation rewards increase monotonically, confirming that the \emph  {Solver}'s improving visual understanding directly translates into more discriminative image generation evaluation.}}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:signal_analysis}{{3}{11}{Signal analysis on BLIP3o-8B revealing the complementary roles of our self-evolving training signals. (a)~The STE difficulty distribution shifts toward harder quantiles as training progresses, reflecting the emergence of an adaptive curriculum where the \emph {Proposer} generates increasingly challenging questions matched to the \emph {Solver}'s evolving competence. (b)~Self-consistency entropy and STE occupy complementary regions of the difficulty space: self-consistency captures framing-level robustness while STE detects token-level uncertainty, together providing a richer supervision signal than either alone. (c)~Both QA fidelity and cycle-consistency image generation rewards increase monotonically, confirming that the \emph {Solver}'s improving visual understanding directly translates into more discriminative image generation evaluation}{figure.caption.14}{}}
\newlabel{fig:signal_analysis@cref}{{[figure][3][]3}{[1][11][]11}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Ablation Study}{11}{subsection.4.3}\protected@file@percent }
\newlabel{sec:ablation}{{4.3}{11}{Ablation Study}{subsection.4.3}{}}
\newlabel{sec:ablation@cref}{{[subsection][3][4]4.3}{[1][11][]11}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Ablation study on BLIP3o-8B isolating the contribution of each framework component under a matched training budget. Each row removes or replaces one component while keeping all others at their default configuration. Removing STE reduces MMMU by $-1.8$ and MMBench by $-1.6$, while removing self-consistency reduces MMMU by $-1.3$ and SEED by $-1.1$, showing that both visual understanding signals are complementary. For image generation, removing QA fidelity causes the largest GenEval drop (87\%$\to $84\%), while removing cycle consistency also degrades compositional quality (87\%$\to $85\%). The full framework achieves the best joint result across both tasks, confirming that all components contribute non-redundant supervision.}}{12}{table.caption.13}\protected@file@percent }
\newlabel{tab:ablation}{{4}{12}{Ablation study on BLIP3o-8B isolating the contribution of each framework component under a matched training budget. Each row removes or replaces one component while keeping all others at their default configuration. Removing STE reduces MMMU by $-1.8$ and MMBench by $-1.6$, while removing self-consistency reduces MMMU by $-1.3$ and SEED by $-1.1$, showing that both visual understanding signals are complementary. For image generation, removing QA fidelity causes the largest GenEval drop (87\%$\to $84\%), while removing cycle consistency also degrades compositional quality (87\%$\to $85\%). The full framework achieves the best joint result across both tasks, confirming that all components contribute non-redundant supervision}{table.caption.13}{}}
\newlabel{tab:ablation@cref}{{[table][4][]4}{[1][11][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Loop coupling dynamics on BLIP3o-8B comparing coupled training against single-loop variants over 10k steps. (a)~For visual understanding, the full framework (blue) consistently outperforms visual understanding-only training (orange), with the synergy gap widening after step 4{,}000 as image generation training provides diverse visual contexts that strengthen the \emph  {Solver}'s perceptual grounding. Image generation-only training (green) contributes negligibly to visual understanding. (b)~For image generation, the full framework similarly exceeds image generation-only training by a growing margin, confirming that improved visual understanding yields a more discriminative internal evaluator. The widening synergy gap in both panels demonstrates that coupling between the two loops strengthens over training rather than saturating early.}}{12}{figure.caption.16}\protected@file@percent }
\newlabel{fig:loop_coupling}{{4}{12}{Loop coupling dynamics on BLIP3o-8B comparing coupled training against single-loop variants over 10k steps. (a)~For visual understanding, the full framework (blue) consistently outperforms visual understanding-only training (orange), with the synergy gap widening after step 4{,}000 as image generation training provides diverse visual contexts that strengthen the \emph {Solver}'s perceptual grounding. Image generation-only training (green) contributes negligibly to visual understanding. (b)~For image generation, the full framework similarly exceeds image generation-only training by a growing margin, confirming that improved visual understanding yields a more discriminative internal evaluator. The widening synergy gap in both panels demonstrates that coupling between the two loops strengthens over training rather than saturating early}{figure.caption.16}{}}
\newlabel{fig:loop_coupling@cref}{{[figure][4][]4}{[1][12][]12}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Loop Coupling Analysis}{12}{subsection.4.4}\protected@file@percent }
\newlabel{sec:loop_coupling}{{4.4}{12}{Loop Coupling Analysis}{subsection.4.4}{}}
\newlabel{sec:loop_coupling@cref}{{[subsection][4][4]4.4}{[1][12][]12}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Loop coupling analysis on BLIP3o-8B comparing the full framework against single-loop variants. Visual understanding-only training improves MMMU ($50.6{\to }52.5$) but slightly degrades image generation (84\%$\to $83\%). Image generation-only training reaches 86\% GenEval but achieves only $51.1$ MMMU. The full framework surpasses both single-loop configurations on both tasks ($52.8$ MMMU, 87\% GenEval), confirming that the visual understanding and image generation loops are mutually reinforcing through the \emph  {Solver}'s dual role as both learner and evaluator.}}{13}{table.caption.15}\protected@file@percent }
\newlabel{tab:loop_ablation}{{5}{13}{Loop coupling analysis on BLIP3o-8B comparing the full framework against single-loop variants. Visual understanding-only training improves MMMU ($50.6{\to }52.5$) but slightly degrades image generation (84\%$\to $83\%). Image generation-only training reaches 86\% GenEval but achieves only $51.1$ MMMU. The full framework surpasses both single-loop configurations on both tasks ($52.8$ MMMU, 87\% GenEval), confirming that the visual understanding and image generation loops are mutually reinforcing through the \emph {Solver}'s dual role as both learner and evaluator}{table.caption.15}{}}
\newlabel{tab:loop_ablation@cref}{{[table][5][]5}{[1][12][]13}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Parameter Strategy Comparison}{13}{subsection.4.5}\protected@file@percent }
\newlabel{sec:param_strategy}{{4.5}{13}{Parameter Strategy Comparison}{subsection.4.5}{}}
\newlabel{sec:param_strategy@cref}{{[subsection][5][4]4.5}{[1][13][]13}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Comparison of parameter update strategies on BLIP3o-8B under the same self-evolving framework. All configurations use identical training data, reward formulation, and optimization schedule, differing only in how model parameters are updated. LoRA (0.8\% of parameters) achieves the best results across all benchmarks, e.g., MMMU $50.6{\to }52.8$ and GenEval 84\%$\to $87\%, demonstrating stable adaptation while preserving pretrained representations. QLoRA also improves but loses $-0.8$ MMMU and $-1\%$ GenEval due to quantization noise in the \emph  {Solver}'s token-level entropy estimates. Full fine-tuning degrades below the base model on several benchmarks (MMMU $50.2$, GenEval 83\%), confirming that freezing the backbone is essential for stability when all training signals are internally generated.}}{14}{table.caption.17}\protected@file@percent }
\newlabel{tab:param_strategy}{{6}{14}{Comparison of parameter update strategies on BLIP3o-8B under the same self-evolving framework. All configurations use identical training data, reward formulation, and optimization schedule, differing only in how model parameters are updated. LoRA (0.8\% of parameters) achieves the best results across all benchmarks, e.g., MMMU $50.6{\to }52.8$ and GenEval 84\%$\to $87\%, demonstrating stable adaptation while preserving pretrained representations. QLoRA also improves but loses $-0.8$ MMMU and $-1\%$ GenEval due to quantization noise in the \emph {Solver}'s token-level entropy estimates. Full fine-tuning degrades below the base model on several benchmarks (MMMU $50.2$, GenEval 83\%), confirming that freezing the backbone is essential for stability when all training signals are internally generated}{table.caption.17}{}}
\newlabel{tab:param_strategy@cref}{{[table][6][]6}{[1][13][]14}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Training Dynamics}{14}{subsection.4.6}\protected@file@percent }
\newlabel{sec:training_dynamics}{{4.6}{14}{Training Dynamics}{subsection.4.6}{}}
\newlabel{sec:training_dynamics@cref}{{[subsection][6][4]4.6}{[1][14][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Training dynamics across all three backbones over 10k steps using one shared recipe. Top row (visual understanding): the \emph  {Proposer} reward increases steadily while self-consistency entropy rises as the \emph  {Proposer} generates progressively harder questions; STE difficulty initially fluctuates but stabilizes around the mid-range by step 4{,}000--5{,}000, reflecting curriculum convergence to the \emph  {Solver}'s evolving competence. On BLIP3o-8B the STE curve becomes stationary around step 6{,}000 (annotated), after which the \emph  {Proposer} continues to push difficulty through SC entropy alone. Bottom row (image generation): total reward, QA fidelity, and cycle-consistency all increase monotonically, with VARGPT-v1.1 starting from a lower absolute level but following the same qualitative trajectory as BLIP3o-8B and BAGEL-7B. Despite fundamentally different image generation mechanisms, all three backbones exhibit qualitatively similar dynamics, and the absence of reward plateaus or oscillations indicates stable optimization throughout.}}{15}{figure.caption.18}\protected@file@percent }
\newlabel{fig:training_dynamics}{{5}{15}{Training dynamics across all three backbones over 10k steps using one shared recipe. Top row (visual understanding): the \emph {Proposer} reward increases steadily while self-consistency entropy rises as the \emph {Proposer} generates progressively harder questions; STE difficulty initially fluctuates but stabilizes around the mid-range by step 4{,}000--5{,}000, reflecting curriculum convergence to the \emph {Solver}'s evolving competence. On BLIP3o-8B the STE curve becomes stationary around step 6{,}000 (annotated), after which the \emph {Proposer} continues to push difficulty through SC entropy alone. Bottom row (image generation): total reward, QA fidelity, and cycle-consistency all increase monotonically, with VARGPT-v1.1 starting from a lower absolute level but following the same qualitative trajectory as BLIP3o-8B and BAGEL-7B. Despite fundamentally different image generation mechanisms, all three backbones exhibit qualitatively similar dynamics, and the absence of reward plateaus or oscillations indicates stable optimization throughout}{figure.caption.18}{}}
\newlabel{fig:training_dynamics@cref}{{[figure][5][]5}{[1][14][]15}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.7}Qualitative Results}{15}{subsection.4.7}\protected@file@percent }
\newlabel{sec:qualitative}{{4.7}{15}{Qualitative Results}{subsection.4.7}{}}
\newlabel{sec:qualitative@cref}{{[subsection][7][4]4.7}{[1][15][]15}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Qualitative examples showing base versus self-evolved outputs across both tasks and all three backbones. Left (visual understanding): before/after answers for three visual questions on BLIP3o-8B, BAGEL-7B, and VARGPT-v1.1. Incorrect base-model answers (\textcolor {red}{red}) are corrected after self-evolving training (\textcolor {ForestGreen}{green}), demonstrating improved object recognition (cat on a suitcase, not a bed), action understanding (cooking $\to $ cutting the fish), and spatial reasoning (straight uphill $\to $ left side of trail). Right (image generation): baseline versus ours for all three backbones---BAGEL-7B, BLIP3o-8B, and VARGPT-v1.1---on three compositional prompts. After training, generated images across all backbones better respect color attributes (red vs.\ blue umbrella), object counts (ripe yellow and unripe green banana), and fine-grained composition (three red and two white roses). These examples confirm that the quantitative gains in Tables~\ref {tab:understanding_results}--\ref {tab:generation_results} are perceptually meaningful and consistent across image generation paradigms.}}{16}{figure.caption.19}\protected@file@percent }
\newlabel{fig:qualitative}{{6}{16}{Qualitative examples showing base versus self-evolved outputs across both tasks and all three backbones. Left (visual understanding): before/after answers for three visual questions on BLIP3o-8B, BAGEL-7B, and VARGPT-v1.1. Incorrect base-model answers (\textcolor {red}{red}) are corrected after self-evolving training (\textcolor {ForestGreen}{green}), demonstrating improved object recognition (cat on a suitcase, not a bed), action understanding (cooking $\to $ cutting the fish), and spatial reasoning (straight uphill $\to $ left side of trail). Right (image generation): baseline versus ours for all three backbones---BAGEL-7B, BLIP3o-8B, and VARGPT-v1.1---on three compositional prompts. After training, generated images across all backbones better respect color attributes (red vs.\ blue umbrella), object counts (ripe yellow and unripe green banana), and fine-grained composition (three red and two white roses). These examples confirm that the quantitative gains in Tables~\ref {tab:understanding_results}--\ref {tab:generation_results} are perceptually meaningful and consistent across image generation paradigms}{figure.caption.19}{}}
\newlabel{fig:qualitative@cref}{{[figure][6][]6}{[1][15][]16}{}{}{}}
