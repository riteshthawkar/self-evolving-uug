\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of our self-evolving framework. We attach three lightweight LoRA adapters---\emph  {Proposer}, \emph  {Solver}, and \emph  {Generator}---to a frozen backbone and train using only unlabeled images. In visual understanding steps (left), the \emph  {Proposer} generates questions and the \emph  {Solver} answers under multiple prompt perturbations; self-consistency and Solver Token Entropy (STE) provide rewards targeting the \emph  {Solver}'s competence frontier. In image generation steps (right), the \emph  {Generator} synthesizes images and the same \emph  {Solver} evaluates them via QA fidelity and cycle-consistent captioning, coupling visual understanding quality into image generation supervision. The design is fully self-supervised and architecture-agnostic.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:intro}{{1}{2}{Overview of our self-evolving framework. We attach three lightweight LoRA adapters---\emph {Proposer}, \emph {Solver}, and \emph {Generator}---to a frozen backbone and train using only unlabeled images. In visual understanding steps (left), the \emph {Proposer} generates questions and the \emph {Solver} answers under multiple prompt perturbations; self-consistency and Solver Token Entropy (STE) provide rewards targeting the \emph {Solver}'s competence frontier. In image generation steps (right), the \emph {Generator} synthesizes images and the same \emph {Solver} evaluates them via QA fidelity and cycle-consistent captioning, coupling visual understanding quality into image generation supervision. The design is fully self-supervised and architecture-agnostic}{figure.caption.2}{}}
