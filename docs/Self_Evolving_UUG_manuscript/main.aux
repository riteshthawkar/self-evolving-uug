\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Loop coupling analysis} on BLIP3o-8B. (a)~Understanding performance and (b)~generation performance measured as relative improvement over the base checkpoint (higher is better). \emph  {Full framework} (blue solid) trains both understanding and generation loops jointly. \emph  {Understanding only} / \emph  {generation only} (dashed) train a single loop in isolation. The opposite-loop baseline (dotted at zero) receives no training signal for that capability. The full framework consistently outperforms either single-loop ablation on \emph  {both} tasks, with the shaded \emph  {synergy gap} showing the additional improvement attributable to cross-loop coupling through the Solver's dual role. Generation performance benefits more from coupling than understanding, as the Solver's question-answering ability directly improves generation assessment quality.}}{16}{figure.caption.24}\protected@file@percent }
\newlabel{fig:loop_coupling}{{5}{16}{\textbf {Loop coupling analysis} on BLIP3o-8B. (a)~Understanding performance and (b)~generation performance measured as relative improvement over the base checkpoint (higher is better). \emph {Full framework} (blue solid) trains both understanding and generation loops jointly. \emph {Understanding only} / \emph {generation only} (dashed) train a single loop in isolation. The opposite-loop baseline (dotted at zero) receives no training signal for that capability. The full framework consistently outperforms either single-loop ablation on \emph {both} tasks, with the shaded \emph {synergy gap} showing the additional improvement attributable to cross-loop coupling through the Solver's dual role. Generation performance benefits more from coupling than understanding, as the Solver's question-answering ability directly improves generation assessment quality}{figure.caption.24}{}}
\newlabel{fig:loop_coupling@cref}{{[figure][5][]5}{[1][15][]16}{}{}{}}
