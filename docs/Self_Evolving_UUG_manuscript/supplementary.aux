\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Lagged correlation between understanding-side and generation-side signals over training. The left panel shows understanding-side metrics at step $t$ versus generation-side metrics at step $t+\Delta $, and the right panel shows the reverse direction. Both directions remain positive over short-to-mid lags, with the understanding-to-generation direction exhibiting the stronger peak. This is consistent with asymmetric loop coupling through the shared \emph  {Solver}, where stronger visual understanding improves later generation-side evaluation more than the reverse.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:sup_lagged_coupling}{{S3}{7}{Lagged correlation between understanding-side and generation-side signals over training. The left panel shows understanding-side metrics at step $t$ versus generation-side metrics at step $t+\Delta $, and the right panel shows the reverse direction. Both directions remain positive over short-to-mid lags, with the understanding-to-generation direction exhibiting the stronger peak. This is consistent with asymmetric loop coupling through the shared \emph {Solver}, where stronger visual understanding improves later generation-side evaluation more than the reverse}{figure.caption.8}{}}
\newlabel{fig:sup_lagged_coupling@cref}{{[figure][3][]S3}{[1][5][]7}{}{}{}}
