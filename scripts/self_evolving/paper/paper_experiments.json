  "evaluation_sets": [
    {
      "id": "understanding_core",
      "metrics": [
        "MMMU",
        "MMBench",
        "TextVQA",
        "SEED-Bench",
        "RealWorldQA",
        "MM-Vet",
        "MME-P",
        "MME-C"
      ]
    },
    {
      "id": "generation_core",
      "metrics": [
        "GenEval",
        "DPG-Bench",
        "WISE"
      ]
    }
