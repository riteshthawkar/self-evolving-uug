  "rebuttal_evidence": [
    {
      "id": "two_stage_control",
      "script": "scripts/self_evolving/final/E7_two_stage.sh",
      "description": "Compare joint alternating training against understanding-first then generation-only training."
    },
    {
      "id": "answer_length_stats",
      "script": "scripts/self_evolving/paper/rebuttal_stats.py",
      "description": "Report solver answer token-length distribution for STE length-normalization concern."
    },
    {
      "id": "compute_cost",
      "script": "scripts/self_evolving/paper/rebuttal_stats.py",
      "description": "Estimate observed and projected wall-clock/GPU-hour training cost."
    },
    {
      "id": "generation_extra_benchmarks",
      "script": "scripts/self_evolving/paper/run_generation_evals.sh",
      "description": "Run GenEval, DPG-Bench, and WISE for base/ours checkpoints."
    }
  ]
